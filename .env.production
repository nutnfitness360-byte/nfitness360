# Valores por defecto de marca para la vista previa del enlace (Open Graph).
# Vercel los SOBRESCRIBE por proyecto: Aretia y Fitmeal definen sus propias
# REACT_APP_SITE_TITLE / REACT_APP_SITE_DESC / REACT_APP_OG_IMAGE.
# La instancia de Natalia NO define nada en Vercel, por lo que usa estos valores.
REACT_APP_SITE_TITLE=Nfitness 360®
REACT_APP_SITE_DESC=Nfitness 360 — Nutrición y bienestar
REACT_APP_OG_IMAGE=/apple-touch-icon.png

# ---- Identidad de la app por instancia: ícono / nombre / tema / manifest ----
# Estos son los valores por DEFECTO (Nfitness / Natalia). Cada instancia los
# SOBRESCRIBE en su propio proyecto de Vercel (Majo, NutriAleGo, Aretia, Fitmeal).
# Gracias a esto, el ícono y el nombre de "Agregar a pantalla de inicio" salen
# correctos por instancia (iOS/Android los leen del HTML ya compilado).
REACT_APP_APP_NAME=Nfitness 360
REACT_APP_PAGE_TITLE=Nfitness 360®
REACT_APP_THEME_COLOR=#211C17
REACT_APP_APPLE_ICON=/apple-touch-icon.png
REACT_APP_FAVICON_32=/favicon-32.png
REACT_APP_FAVICON_ICO=/favicon.ico
REACT_APP_MANIFEST=/manifest.json
