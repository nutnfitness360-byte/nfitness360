 * Recetario Nfitness360 - banco de platillos reales por tiempo.
 * n = nombre, c = componentes (grupo SMAE + alimento + cantidad POR 1 EQUIVALENTE), p = preparacion base.
 * Lo usa generarMenusIA_ para que la IA proponga y ADAPTE platillos reales a los equivalentes del plan.
 * Historicos de Natalia + tandas IA ago2026 (~2188 platillos).
 */

// ─────────────────────────────────────────────────────────────────────────────
// tiempoCategoria_  (VERSIÓN CON COLACIONES — vive aquí, junto al recetario)
// Reconoce colaciones (colación / snack / refrigerio / media mañana / media
// tarde / entre comidas) para que la IA use la sección "colacion" del recetario.
// Si en tu Código.gs quedó una copia vieja de tiempoCategoria_, bórrala.
// ─────────────────────────────────────────────────────────────────────────────
function tiempoCategoria_(nombre) {
  var n = (nombre || '').toLowerCase();
  if (n.indexOf('colaci') > -1 || n.indexOf('snack') > -1 || n.indexOf('refrigerio') > -1 ||
      n.indexOf('media ma') > -1 || n.indexOf('media tar') > -1 || n.indexOf('entre comida') > -1) return 'colacion';
  if (n.indexOf('desayuno') > -1) return 'desayuno';
  if (n.indexOf('comida') > -1) return 'comida';
  if (n.indexOf('cena') > -1) return 'cena';
  return '';
}

